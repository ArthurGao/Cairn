{
  "name": "cairn-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4710",
    "build": "next build",
    "start": "next start -p 4710",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "e2e:full": "playwright test --config playwright.full.config.ts",
    "api:gen": "node scripts/api-check.mjs --write",
    "api:check": "node scripts/api-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "next": "15.5.28",
    "openapi-fetch": "^0.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
