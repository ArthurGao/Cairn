# Frontend settings. Copy to `.env.local` (Next.js loads it in dev). Only NEXT_PUBLIC_* reach the
# browser, so never put a secret here.

# Backend API base URL (design §11).
NEXT_PUBLIC_API_URL=http://localhost:4700

# Base URL the full e2e suite drives (tests/e2e-full, assumes `make dev`).
PLAYWRIGHT_BASE_URL=http://localhost:4710
