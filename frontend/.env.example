# Frontend settings. Copy to `.env.local` (Next.js loads it in dev). Only NEXT_PUBLIC_* reach the
# browser, so never put a secret here.

# Backend API base URL (design §11).
NEXT_PUBLIC_API_URL=http://localhost:4700

# Demo sign-in gate (design §16.1): set all three on the Vercel deployment (Production env), none
# locally. On Vercel a missing one closes the site (503) instead of opening it. DEMO_USER and
# DEMO_PASSWORD are the same credential the VM's Caddy checks; SESSION_SECRET signs the cookie
# (openssl rand -hex 32). Server-only: never NEXT_PUBLIC_.
DEMO_USER=
DEMO_PASSWORD=
SESSION_SECRET=

# Base URL the full e2e suite drives (tests/e2e-full, assumes `make dev`).
PLAYWRIGHT_BASE_URL=http://localhost:4710
