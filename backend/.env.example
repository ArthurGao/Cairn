# Backend settings, read by src/cairn/settings.py (pydantic-settings). Copy to `.env` and fill in.
# Every variable settings.py declares is listed here; keep the two in sync.
# Relative paths resolve from backend/ (where the worker, API and CLI run).

# --- Storage (design §3) ---
CAIRN_HOME=../workspace
# Must be outside CAIRN_HOME; the worker refuses to start otherwise.
CAIRN_CASES_DIR=../.cases
# Colon-separated read-only skill sources, e.g. ~/.agents/skills
CAIRN_SKILL_PATHS=

# --- Data-class gate (design §10.4, D-15) ---
# synthetic | client. v1 refuses `client` with the gateway/anthropic vendors.
CAIRN_DATA_CLASS=synthetic
CAIRN_CLIENT_DATA_VENDORS=

# --- LLM vendors (design §10) ---
# Vercel AI Gateway key: vercel.com -> AI Gateway -> API keys. Default vendor for every role.
AI_GATEWAY_API_KEY=
# Only needed when a role is switched to the direct `anthropic` vendor.
ANTHROPIC_API_KEY=
# Set to `fake` to force every role onto scripted replies (tests, `make e2e-full`).
CAIRN_LLM_VENDOR=
# Scenario JSON files the fake vendor replays, colon-separated (required when any role uses `fake`).
CAIRN_FAKE_SCENARIO=
# Role -> vendor/model/effort/max_tokens defaults (design §10.2).
CAIRN_ROLES_FILE=config/roles.toml
# Per-role overrides of config/roles.toml: CAIRN_ROLE_<ROLE>_<VENDOR|MODEL|EFFORT|MAX_TOKENS>
# CAIRN_ROLE_MEMORY_CONSOLIDATE_MODEL=openai/gpt-5.4-mini
# CAIRN_ROLE_CASE_EXTRACT_FACTS_VENDOR=anthropic
# CAIRN_ROLE_CASE_EXTRACT_FACTS_MODEL=claude-sonnet-5-5

# --- Temporal and API ---
CAIRN_TEMPORAL_ADDRESS=localhost:7233
CAIRN_TEMPORAL_NAMESPACE=default
CAIRN_TASK_QUEUE=cairn
CAIRN_CORS_ORIGIN=http://localhost:4710

# --- Progressive disclosure and agent runs (design §4.2, §5, §6) ---
CAIRN_L0_BUDGET=4000
CAIRN_MEMORY_INDEX_BUDGET=1500
CAIRN_MAX_STEPS=8

# --- Case checks (design §8) ---
CAIRN_MAP_BUDGET=100000
CAIRN_CASE_CONTEXT_BUDGET=150000
CAIRN_MIN_PAGE_CHARS=40
CAIRN_CHECK_CONCURRENCY=4
CAIRN_ITEM_BATCH_SIZE=5
CAIRN_MAX_DOCUMENTS_PER_CASE=100
CAIRN_MAX_PAGES_PER_CASE=500
CAIRN_MAX_UPLOAD_MB=20

# --- Memory cleanup (design §7) ---
CAIRN_CLEANUP_CRON=0 3 * * 0
CAIRN_TZ=Pacific/Auckland
CAIRN_STALE_DAYS=90
CAIRN_DUP_THRESHOLD=0.82
CAIRN_DUP_BODY_THRESHOLD=0.70
# ISO 8601 duration; must stay shorter than the weekly schedule.
CAIRN_REVIEW_TIMEOUT=P6D
CAIRN_AUTO_APPLY_MECHANICAL=true
