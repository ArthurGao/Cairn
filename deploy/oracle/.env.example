# Public mode on the demo VM (design §16.1, bootstrap.md appendix): copy to ~/cairn/.env (mode 600).
# Never commit the real file. Other people use this stack, so every model role runs on the
# gateway key below: never on llm-gateway or a personal subscription (D-19, D-22).

# Public host name: the VM's IP through sslip.io gives Caddy a real certificate without a domain.
CAIRN_HOST=203.0.113.10.sslip.io

# The gate in front of pages and API. Hash: docker run --rm caddy:2.10.2 caddy hash-password
# Keep the single quotes: the hash contains `$`, which Compose would otherwise interpolate.
# With the frontend on Vercel, the same user and password are its DEMO_USER / DEMO_PASSWORD.
DEMO_USER=demo
DEMO_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# A dedicated Vercel AI Gateway key with a budget, used only by this demo.
AI_GATEWAY_API_KEY=

# The frontend's origin when it runs on Vercel (its production domain, https://…vercel.app):
# the only origin allowed to call the API from a browser. Empty: none (the VM's own web app).
CAIRN_CORS_ORIGIN=

# Synthetic data only (design §10.4); the worker refuses to start otherwise.
CAIRN_DATA_CLASS=synthetic
CAIRN_TZ=Pacific/Auckland
