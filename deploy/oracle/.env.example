# Public mode on the demo VM (design §16.1, bootstrap.md appendix): copy to ~/cairn/.env (mode 600).
# Never commit the real file. When other people use this stack, every model role runs on the
# gateway key below: never on llm-gateway or a personal subscription (D-19, D-22). The owner-only
# variant is at the end.

# Public host name: the VM's IP through sslip.io gives Caddy a real certificate without a domain.
CAIRN_HOST=203.0.113.10.sslip.io

# The gate in front of pages and API. Hash: docker run --rm caddy:2.10.2 caddy hash-password
# Keep the single quotes: the hash contains `$`, which Compose would otherwise interpolate.
# With the frontend on Vercel, the same user and password are its DEMO_USER / DEMO_PASSWORD.
DEMO_USER=demo
DEMO_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# A dedicated Vercel AI Gateway key with a budget, used only by this demo.
AI_GATEWAY_API_KEY=
# On the Vercel AI Gateway free tier (no paid credits) every anthropic/* model answers 403, so
# images and the agent move to OpenAI models the free tier allows (checked 2026-10-26):
# CAIRN_ROLE_DOCUMENT_TRANSCRIBE_MODEL=openai/gpt-5
# CAIRN_ROLE_AGENT_MAIN_MODEL=openai/gpt-5-mini

# The frontend's origin when it runs on Vercel (its production domain, https://…vercel.app):
# the only origin allowed to call the API from a browser. Empty: none (the VM's own web app).
CAIRN_CORS_ORIGIN=

# Owner-only public (D-22 amendment): while nobody but the owner has the sign-in credential, the
# text roles may run on the owner's subscription through llm-gateway on the VM. Uncomment this
# block (token from ~/.config/llmgw/env). Before giving anyone the credential, comment it out
# again, redeploy, and run `claude auth logout` on the VM.
# COMPOSE_FILE=docker-compose.yml:docker-compose.llmgw.yml
# CAIRN_LLMGW_BASE_URL=http://127.0.0.1:8787/v1
# CAIRN_LLMGW_TOKEN=
# CAIRN_ROLE_CASE_EXTRACT_FACTS_VENDOR=llmgw
# CAIRN_ROLE_CASE_EXTRACT_FACTS_MODEL=claude-sub
# CAIRN_ROLE_CASE_COMPARE_FACTS_VENDOR=llmgw
# CAIRN_ROLE_CASE_COMPARE_FACTS_MODEL=claude-sub
# CAIRN_ROLE_CASE_CHECK_ITEM_VENDOR=llmgw
# CAIRN_ROLE_CASE_CHECK_ITEM_MODEL=claude-sub
# CAIRN_ROLE_CASE_READ_LETTER_VENDOR=llmgw
# CAIRN_ROLE_CASE_READ_LETTER_MODEL=claude-sub
# CAIRN_ROLE_CASE_MATCH_EVIDENCE_VENDOR=llmgw
# CAIRN_ROLE_CASE_MATCH_EVIDENCE_MODEL=claude-sub
# CAIRN_ROLE_MEMORY_EXTRACT_VENDOR=llmgw
# CAIRN_ROLE_MEMORY_EXTRACT_MODEL=claude-sub
# CAIRN_ROLE_MEMORY_CONSOLIDATE_VENDOR=llmgw
# CAIRN_ROLE_MEMORY_CONSOLIDATE_MODEL=claude-sub

# Synthetic data only (design §10.4); the worker refuses to start otherwise.
CAIRN_DATA_CLASS=synthetic
CAIRN_TZ=Pacific/Auckland
