# Private mode on the demo VM: copy to ~/cairn/.env (mode 600). Never commit the real file.
# Only the owner uses this stack (ssh -L 8080:127.0.0.1:8080 <vm>); the text roles run on the
# owner's Claude subscription through llm-gateway on the VM. Never share the tunnel or the
# credentials: anyone else using it would be using a personal subscription (D-19, D-22).
COMPOSE_FILE=docker-compose.yml:docker-compose.llmgw.yml:docker-compose.private.yml

# Caddy serves plain HTTP on the VM's loopback (:80 = any host name); the gate stays as defence
# in depth. Hash: docker run --rm -it caddy:2.10.2 caddy hash-password (keep the single quotes).
CAIRN_HOST=:80
DEMO_USER=demo
DEMO_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# llm-gateway on the VM's loopback (systemd user service, llm-gateway docs/PRIVATE_HOST.md), with
# the bearer token from its environment file.
CAIRN_LLMGW_BASE_URL=http://127.0.0.1:8787/v1
CAIRN_LLMGW_TOKEN=
CAIRN_ROLE_CASE_EXTRACT_FACTS_VENDOR=llmgw
CAIRN_ROLE_CASE_EXTRACT_FACTS_MODEL=claude-sub
CAIRN_ROLE_CASE_COMPARE_FACTS_VENDOR=llmgw
CAIRN_ROLE_CASE_COMPARE_FACTS_MODEL=claude-sub
CAIRN_ROLE_CASE_CHECK_ITEM_VENDOR=llmgw
CAIRN_ROLE_CASE_CHECK_ITEM_MODEL=claude-sub
CAIRN_ROLE_CASE_READ_LETTER_VENDOR=llmgw
CAIRN_ROLE_CASE_READ_LETTER_MODEL=claude-sub
CAIRN_ROLE_CASE_MATCH_EVIDENCE_VENDOR=llmgw
CAIRN_ROLE_CASE_MATCH_EVIDENCE_MODEL=claude-sub
CAIRN_ROLE_MEMORY_EXTRACT_VENDOR=llmgw
CAIRN_ROLE_MEMORY_EXTRACT_MODEL=claude-sub
CAIRN_ROLE_MEMORY_CONSOLIDATE_VENDOR=llmgw
CAIRN_ROLE_MEMORY_CONSOLIDATE_MODEL=claude-sub

# document.transcribe (images) and agent.main (tools) stay on the Vercel AI Gateway: llm-gateway
# v1 serves neither. A dedicated key with a small budget.
AI_GATEWAY_API_KEY=

CAIRN_DATA_CLASS=synthetic
CAIRN_TZ=Pacific/Auckland
